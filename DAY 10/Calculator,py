def add(n1,n2):
        return n1 + n2  
def sub(n1,n2):
        return n1 - n2
def multiply(n1,n2):
        return n1 * n2
def division(n1,n2):
        return n1 / n2
my_dict = {
        "+" : add,
        "-" : sub,
        "*" : multiply,
        "/" : division,
    }
def calculate():
    while True:
    
        n1 = float(input("Enter the first Number: "))
        operator = input(" +\n -\n *\n /\n Pick an operation:  ")
        n2 = float(input("Enter the second number: "))
    
        answer = my_dict[operator](n1,n2)
        print(f"{n1} {operator} {n2} = {answer}")
        while True:
            ok = input(f"Type 'y' to contine calculating with {answer}, or type 'n' to start a new calculation: ")
            if ok == "y":
                n1 = answer
                operator = input(" +\n -\n *\n /\n Pick an operation:  ")
                n2 = float(input("Enter the second number: "))
                final_answer = my_dict[operator](n1,n2)
                print(f"{n1} {operator} {n2} = {final_answer}")
            

            elif ok == "n":
                print("\n"*20)
                break
            
calculate()